# ============================================================================
# MySQL 8.0 小内存调优（2G 机器专用）
# 放置：/etc/mysql/mysql.conf.d/zz-rural-small.cnf
# 生效：sudo systemctl restart mysql
#
# 默认配置在 2G 机器上会让 mysqld 常驻 500~700MB，这里压到约 350~450MB。
# 数据量只有 200MB 左右，128M 的 buffer pool 完全够用。
# ============================================================================

[mysqld]
# 最吃内存的一项：默认 128M 已在低位，这里显式写死，避免被镜像配置覆盖
innodb_buffer_pool_size = 128M
innodb_log_buffer_size  = 16M

# 关掉性能采集（省 100~200MB，与本项目无关）
performance_schema = off

# 连接数与线程缓存：本项目是单体应用，15 个连接池足够
max_connections   = 100
thread_cache_size = 8
table_open_cache  = 400

# 临时表内存，防止大排序把内存吃爆
tmp_table_size      = 32M
max_heap_table_size = 32M

# 字符集（与建库一致）
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci

# 只监听本机，公网不可直连数据库
bind-address = 127.0.0.1
