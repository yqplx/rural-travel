# ============================================================================
# 生产环境变量模板
# 用法：复制到 /opt/rural-travel/.env（权限 600，属主 rural）
#   cp deploy/env.prod.example /opt/rural-travel/.env
#   chmod 600 /opt/rural-travel/.env && chown rural:rural /opt/rural-travel/.env
#
# 生成强随机值：
#   openssl rand -base64 48 | tr -d '\n'
#
# 注意：本文件不得提交真实口令，仓库里只保留本模板。
# ============================================================================

# ---------- 运行时 ----------
SPRING_PROFILES_ACTIVE=prod
# 指向外置配置目录（必须以 / 结尾）
SPRING_CONFIG_ADDITIONAL_LOCATION=file:/opt/rural-travel/config/
BACKEND_PORT=8091

# ---------- 数据库 ----------
# 生产用 3306，不是本地分发包的 3307
# 注意：值里有 & 符号，必须保留这对双引号；否则 shell 会把 & 当命令分隔符导致变量被截断
SPRING_DATASOURCE_URL="jdbc:mysql://127.0.0.1:3306/rural_travel?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false&rewriteBatchedStatements=true"
DB_USER=rural
DB_PASS=CHANGE_ME_db_password

# ---------- 安全 ----------
# 必填。HS256 建议 >= 32 字符；不填则后端起不来（这是故意的）
JWT_SECRET=CHANGE_ME_use_openssl_rand_base64_48
JWT_EXPIRE_HOURS=12

# 必填。加密用户自填的 AI Key 用的 AES 密钥。
# ！！关键决策：如果要从现有数据库迁移用户已存的 AI Key，必须沿用旧值
#              rural-travel-ai-crypto-2026
#              一旦更换，库里所有已加密 Key 全部解不开，用户需重新填写。
AI_CRYPTO_SECRET=CHANGE_ME_or_keep_rural-travel-ai-crypto-2026

# ---------- 站点 ----------
# 识景功能按此地址抓图，必须是用户浏览器能访问的公网地址（含协议，不带结尾斜杠）
SITE_BASE_URL=https://example.com

# ---------- AI（可选）----------
# 留空 = 不提供公共 Key，用户各自在个人中心填；这也是最安全的默认
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_CHAT_MODEL=deepseek-chat
AI_VISION_MODEL=
