# ============================================================================
# systemd 服务单元 · 乡野智游后端（2 核 2G 机器专用版）
# 与 rural-travel.service 的唯一区别：JVM 堆从 1G 降到 512M，并限制元空间
# 放置：/etc/systemd/system/rural-travel.service
# 前提：已执行 deploy/scripts/setup-swap.sh 加好 2G swap
# ============================================================================

[Unit]
Description=Rural Travel Backend (Spring Boot, 2G profile)
Documentation=file:/opt/rural-travel/DEPLOY.md
After=network-online.target mysql.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=rural
Group=rural
WorkingDirectory=/opt/rural-travel

EnvironmentFile=/opt/rural-travel/.env

# 2G 机器：堆 512M + 元空间 192M，RSS 约 600~800M，给 MySQL 和系统留足余量
ExecStart=/usr/bin/java -Xms256m -Xmx512m -XX:MaxMetaspaceSize=192m \
          -XX:+UseG1GC -XX:MaxGCPauseMillis=200 \
          -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/var/log/rural-travel \
          -Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8 \
          -jar /opt/rural-travel/app.jar

SuccessExitStatus=143
Restart=always
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65535

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/log/rural-travel

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rural-travel

[Install]
WantedBy=multi-user.target
